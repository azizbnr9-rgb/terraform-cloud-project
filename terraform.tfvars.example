# Modèle de variables — copier dans environments/<env>/terraform.tfvars et adapter.
# AUCUN secret ici : le mot de passe RDS est généré et stocké par AWS Secrets Manager,
# les identifiants AWS viennent de l'environnement (CloudShell, SSO, secrets CI/CD).

aws_region   = "us-east-1"     # Learner Lab : us-east-1 ou us-west-2
project_name = "cloud5"        # préfixe de nommage <projet>-<env>-<ressource>
environment  = "dev"           # dev | test | prod
owner        = "equipe-cloud5" # tag Owner

# Réseau (/16 ; sous-réseaux /24 dérivés : .1-.2 publics, .11-.12 app, .21-.22 DB)
vpc_cidr           = "10.20.0.0/16"
az_count           = 2
single_nat_gateway = true # false = une NAT par AZ (prod)
allowed_web_cidrs  = ["0.0.0.0/0"]

# IAM : false sur AWS Academy Learner Lab (création IAM interdite)
create_iam_role                = false
existing_instance_profile_name = "LabInstanceProfile"

# Calcul
instance_type    = "t3.micro"
min_size         = 2
max_size         = 4
desired_capacity = 2
# certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/xxxx" # active HTTPS

# Base de données
db_instance_class        = "db.t3.micro"
db_multi_az              = false
db_backup_retention_days = 1
db_deletion_protection   = false
db_skip_final_snapshot   = true

# Stockage
force_destroy_storage   = true
alb_deletion_protection = false
log_retention_days      = 31
